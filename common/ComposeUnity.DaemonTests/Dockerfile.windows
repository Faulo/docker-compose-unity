FROM mcr.microsoft.com/dotnet/runtime-deps:9.0-nanoserver-1809
COPY controller/compose-unity.exe C:/Windows/compose-unity-controller.exe
COPY backend/compose-unity.exe C:/Windows/compose-unity.exe
COPY backend/compose-unity.exe C:/Windows/php.exe
USER ContainerAdministrator
ENV COMPOSE_UNITY_CALL_TIMEOUT=30
EXPOSE 8080
HEALTHCHECK --interval=1s --timeout=5s --start-period=1s --retries=30 \
    CMD ["compose-unity-controller.exe", "sidecar", "health"]
CMD ["compose-unity-controller.exe", "sidecar"]
